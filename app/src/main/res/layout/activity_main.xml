<?xml version="1.0" encoding="utf-8"?>
<linearlayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dt"
        android:background="#12121a">

        <EditText android:id="@+id/etUrl"
            android:layout_width="0dt"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Poisk v NikeBoss..."
            android:textColorHint="#5a5a75"
            android:textColor="#e6e6f0"
            android:background="#0f0f18"
            android:padding="12dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri" />
        </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dt"
        android:layout_weight="1">

        <WebView android:id="@+id/webVew"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</linearLayout>